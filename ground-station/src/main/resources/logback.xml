<configuration>
    <!-- Warnings and errors go to the standard error output, message only.
         The results of the program are not logged: Main writes them to the standard output. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- The Kafka client logs its configuration and connections in INFO: only its problems are shown -->
    <logger name="org.apache.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
